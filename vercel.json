{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "destination": "/api/handler?path=/$1"
    },
    {
      "source": "/(timer|about|contact|privacy)",
      "destination": "/index.html"
    },
    {
      "source": "/((?!assets|audio|backgrounds|api|.*\\..*).*)",
      "destination": "/api/handler?path=/$1"
    }
  ]
}
